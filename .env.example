# RepairLoop API — copy to .env for local development.
# Never commit real values. Production values live in /etc/repairloop/api.env on the VPS.

NODE_ENV=development
PORT=3002
HOST=127.0.0.1
DATABASE_URL=postgres://repairloop:CHANGE_ME@127.0.0.1:5432/repairloop
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Gemini free tier
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-3.5-flash-lite
AI_ENABLED=true

# PayPal Sandbox only
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_SECRET=CHANGE_ME
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=CHANGE_ME

DEMO_MODE=true
LOG_LEVEL=info
