# RepairLoop API environment template.
# Copy to .env for development. Never commit real values.

NODE_ENV=development
PORT=3002
HOST=127.0.0.1
DATABASE_URL=postgres://repairloop:CHANGE_ME@127.0.0.1:5432/repairloop
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Gemini free tier
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=CHANGE_ME
AI_ENABLED=true

# PayPal Sandbox only
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_SECRET=CHANGE_ME
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Comma-separated if PayPal requires one event per webhook.
PAYPAL_WEBHOOK_ID=CHANGE_ME

DEMO_MODE=true
# Explicit opt-in; never enable for the sandbox demo.
PAYPAL_LIVE_ENABLED=false
LOG_LEVEL=info
